# Copy this file to .env and fill in values locally. Never commit .env.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_ID=
# Optional additional accounts: TELEGRAM_ID:SPREADSHEET_ID, comma-separated.
TELEGRAM_USER_SHEETS=
GOOGLE_CREDENTIALS_FILE=./secrets/google-service-account.json
GOOGLE_SHEET_ID=
GOOGLE_TRANSACTIONS_SHEET=Траты
GOOGLE_CATEGORIES_SHEET=Категории
GOOGLE_ANALYTICS_SHEET=Аналитика
BOT_TIMEZONE=Europe/Moscow
